{
	"version": "0.5.0",
	"license": "Unlicense",
	"name": "@charliewilco/toolkit",
	"author": "Charlie ⚡️ <charliewilc0@pm.me>",
	"module": "./index.mjs",
	"repository": "charliewilco/toolkit",
	"main": "./index.js",
	"typings": "./index.d.ts",
	"sideEffect": false,
	"files": [
		"./*.d.ts",
		"./*.js",
		"./*.mjs",
		"./*.map"
	],
	"scripts": {
		"prebuild": "pnpm clean",
		"build": "tsup src/*.ts",
		"postbuild": "node scripts/move-output.mjs",
		"lint": "biome check",
		"dev": "tsup src/*.ts --watch",
		"test": "jest",
		"format": "pretty-quick --staged",
		"clean": "node scripts/clean.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@jest/globals": "^30.0.0",
		"@swc/jest": "^0.2.38",
		"arg": "^5.0.2",
		"chalk": "^5.2.0",
		"del": "^7.0.0",
		"jest": "^30.0.0",
		"ts-jest": "^29.4.0",
		"tsup": "^8.5.0",
		"typescript": "^5"
	},
	"tsup": {
		"sourcemap": true,
		"clean": true,
		"dts": true,
		"splitting": true,
		"format": [
			"esm",
			"cjs"
		]
	},
	"jest": {
		"preset": "ts-jest/presets/default-esm",
		"testEnvironment": "node",
		"verbose": true
	},
	"packageManager": "pnpm@10.11.0",
	"dependencies": {
		"lefthook": "^1.11.13",
		"tslib": "^2.8.1"
	}
}